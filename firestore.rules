rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ═══════════════════════════════════════════════════
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isDeveloper() {
      return request.auth != null && getUserRole() == 'developer';
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }


    // ═══════════════════════════════════════════════════
    // 1. USERS — Profil user & presence
    // ═══════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      allow update: if isAuthenticated() && (
        isDeveloper() ||
        (request.auth.uid == userId 
         && !request.resource.data.diff(resource.data)
             .affectedKeys().hasAny(['role']))
      );
      
      allow create: if isDeveloper();
      allow delete: if isDeveloper();
    }


    // ═══════════════════════════════════════════════════
    // 2. PRODUCTS — Master produk & stok
    // ═══════════════════════════════════════════════════
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }


    // ═══════════════════════════════════════════════════
    // 3. CUSTOMERS — Master pelanggan
    // ═══════════════════════════════════════════════════
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }


    // ═══════════════════════════════════════════════════
    // 4. TRANSACTIONS — Transaksi penjualan
    // ═══════════════════════════════════════════════════
    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }


    // ═══════════════════════════════════════════════════
    // 5. COUNTERS — Auto-increment nomor invoice
    // ═══════════════════════════════════════════════════
    match /counters/{counterId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }


    // ═══════════════════════════════════════════════════
    // 6. ERP_SUMMARY — Ringkasan ERP bulanan
    // ═══════════════════════════════════════════════════
    match /erp_summary/{summaryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }


    // ═══════════════════════════════════════════════════
    // 7. RETURNS — Retur produk (DEVELOPER ONLY)
    // ═══════════════════════════════════════════════════
    match /returns/{returnId} {
      allow read: if isAuthenticated();
      allow create: if isDeveloper();
      allow update, delete: if false;
    }


    // ═══════════════════════════════════════════════════
    // 8. STAFF — Data pegawai
    // ═══════════════════════════════════════════════════
    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }


    // ═══════════════════════════════════════════════════
    // 9. ATTENDANCE — Absensi pegawai
    // ═══════════════════════════════════════════════════
    match /attendance/{recordId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }


    // ═══════════════════════════════════════════════════
    // 10. SETTINGS — Pengaturan app (DEVELOPER ONLY)
    // ═══════════════════════════════════════════════════
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isDeveloper();
    }


    // ═══════════════════════════════════════════════════
    // 11. STOCK_ENTRIES — Catatan stok masuk/keluar
    // ═══════════════════════════════════════════════════
    match /stock_entries/{entryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }


    // ═══════════════════════════════════════════════════
    // 12. MONTHLY_STOCK_INITIAL — Stok awal bulanan
    // ═══════════════════════════════════════════════════
    match /monthly_stock_initial/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }


    // ═══════════════════════════════════════════════════
    // 13. RECEIVABLES — Kartu piutang toko
    // ═══════════════════════════════════════════════════
    match /receivables/{receivableId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }


    // ═══════════════════════════════════════════════════
    // 14. IDEMPOTENCY_KEYS — Kunci anti-duplikasi invoice
    // ═══════════════════════════════════════════════════
    match /idempotency_keys/{keyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }


    // ═══════════════════════════════════════════════════
    // 15. OPERATIONAL_INVOICES — Invoice Biaya Operasional (DEVELOPER ONLY)
    // ═══════════════════════════════════════════════════
    match /operational_invoices/{docId} {
      allow read: if isAuthenticated();
      allow write: if isDeveloper();
    }


    // ═══════════════════════════════════════════════════
    // 16. MONTHLY_OPERATIONAL_EXPENSES — Biaya Operasional Bulanan
    // ═══════════════════════════════════════════════════
    match /monthly_operational_expenses/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }


    // ═══════════════════════════════════════════════════
    // 17. STOCK_MUTATIONS — Riwayat mutasi stok (keluar/masuk/retur)
    // ═══════════════════════════════════════════════════
    match /stock_mutations/{mutationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }


    // ═══════════════════════════════════════════════════
    // 18. OPERATIONAL_CATEGORIES — Kategori Biaya Operasional
    // ═══════════════════════════════════════════════════
    match /operational_categories/{docId} {
      allow read: if isAuthenticated();
      allow write: if isDeveloper();
    }


    // ═══════════════════════════════════════════════════
    // 19. OPERATIONAL_PAYMENT_METHODS — Metode Pembayaran Operasional
    // ═══════════════════════════════════════════════════
    match /operational_payment_methods/{docId} {
      allow read: if isAuthenticated();
      allow write: if isDeveloper();
    }


    // ═══════════════════════════════════════════════════
    // 20. WA_CONTACTS — Daftar Kontak WhatsApp
    // ═══════════════════════════════════════════════════
    match /wa_contacts/{contactId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }


    // ═══════════════════════════════════════════════════
    // 21. MONTHLY_TARGETS — Target Bulanan Cabang
    // ═══════════════════════════════════════════════════
    match /monthly_targets/{targetId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }


    // ═══════════════════════════════════════════════════
    // 22. INVOICE_PRINT_LOGS — Log Cetak Invoice Real-Time
    // ═══════════════════════════════════════════════════
    match /invoice_print_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isDeveloper();
    }


    // ═══════════════════════════════════════════════════
    // 23. REMOTE_PRINT_COMMANDS — Perintah Cetak Jarak Jauh (WFH -> Kantor)
    // ═══════════════════════════════════════════════════
    match /remote_print_commands/{cmdId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isDeveloper();
    }


    // ═══════════════════════════════════════════════════
    // CATCH-ALL: Blokir collection lain
    // ═══════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
